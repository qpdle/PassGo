{$PASSGO_DOMAIN} {
    encode gzip
    handle /api/* {
        reverse_proxy backend:8000
    }
    handle /admin* {
        reverse_proxy backend:8000
    }
    handle_path /static/* {
        root * /static
        file_server
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
