FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY requirements*.txt ./
RUN pip install -r requirements-production.txt && useradd --uid 10001 --create-home appuser && mkdir /app/staticfiles && chown appuser:appuser /app/staticfiles
COPY --chown=appuser:appuser . .
USER appuser
CMD ["gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "1", "--access-logfile", "-"]
